#include<iostream>
#define max 3
using namespace std;
class cirque
{
 int a[max],f,r,x;
 public:
 cirque()
 {
 f=-1;
 r=-1;
 }
  void insert();
  void delete1();
  void display();

};
void cirque::insert()
{
  if(f==((r+1)%max))
  {
  cout<<"stack overflows"<<endl;
  }
  else{
  cout<<"enter elements";
  cin>>x;
  if(f==-1){
   f=r=0;
   a[r]=x;
   }
   else{
   r=(r+1)%max;
   a[r]=x;
   }
  }

}
void cirque::delete1()
{
 if(f==-1){
 cout<<"\n queue is empty"<<endl;
 }
 else{
  x=a[f];
  if(f==r){
   f=r=-1; 
  }
  else{
   f=(f+1)%max; 
  }
  cout<<"deleted item is"<<x<<endl;
 }
}
void cirque::display()
{
 if(f==-1){
  cout<<"queue has no elements"<<endl;
 }
 else{
 if(f<=r){
 for(int i=f;i<=r;i++){
  cout<<a[i];
  }
  }
  else{
  for(int j=f;j<max;j++){
  cout<<a[j];
  }
  for(int k=0;k<=r;k++){
  cout<<a[k];
  }
  }
 }
}
int main()
{
    cirque q;
    char c;
    int choice;

    do
    {
        cout << "Choose choice";
        cout << "\n 1 insert 2 delete 3 display"<<endl;
        cin >> choice;

        switch (choice)
        {
            case 1:
                q.insert();
                break;

            case 2:
                q.delete1();
                break;

            case 3:
                q.display();
                break;
        }

        cout << "Do you want to continue?"<<endl;
        cin>>c;

    } while (c == 'Y' || c == 'y');
    
    return 0;
}
