#include <iostream>
#define MAX 3
using namespace std;

class myqueue
{
    int a[MAX];
    int f, r, x;

public:
    myqueue()
    {
        f = -1;
        r = -1;
    }

    void insert();
    void delete1();
    void display();
};

void myqueue::insert()
{
    if (r == MAX - 1)
    {
        cout << "\n Queue overflow";
    }
    else
    {
        cout << "\n Enter elements"<<endl;
        cin >> x;

        if (r == -1)
        {
            f = r = 0;
        }
        else
        {
            r++;
        }

        a[r] = x;
    }
}

void myqueue::delete1()
{
    if (f == -1)
        cout << "Queue overflow"<<endl;
    else
    {
        x = a[f];

        if (f == r)
        {
            f = r = -1;
        }
        else
        {
            f++;
        }

        cout << "Deleted item" << x<<endl;
    }
}
void myqueue::display()
{
    if (f == -1)
        cout << "Queue has no elements"<<endl;
    else
    {
        for (int i = f; i <= r; i++)
            cout << a[i] << endl;
    }
}

int main()
{
    myqueue q;
    char c;
    int choice;

    do
    {
        cout << "Choose choice";
        cout << "\n 1 insert 2 delete 3 display"<<endl;
        cin >> choice;

        switch (choice)
        {
            case 1:
                q.insert();
                break;

            case 2:
                q.delete1();
                break;

            case 3:
                q.display();
                break;
        }

        cout << "Do you want to continue?"<<endl;
        cin>>c;

    } while (c == 'Y' || c == 'y');
    
    return 0;
}


